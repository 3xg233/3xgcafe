<Window x:Class="ScreenGuard.ButtonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="3xgcafe Guard"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowActivated="False"
        Focusable="False"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="False"
        Width="80"
        Height="26"
        SourceInitialized="OnSourceInitialized"
        MouseLeftButtonDown="OnMouseLeftButtonDown"
        MouseMove="OnMouseMove"
        MouseLeftButtonUp="OnMouseLeftButtonUp"
        MouseRightButtonDown="OnRightClick">
    <Border x:Name="RootBorder"
            CornerRadius="13"
            Background="#FFFAFC52"
            BorderBrush="#FF14141A"
            BorderThickness="1"
            Cursor="Hand">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.35" Color="#000000" />
        </Border.Effect>
        <TextBlock Text="锁定"
                   Foreground="#FF14141A"
                   FontWeight="SemiBold"
                   FontSize="12"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
    </Border>
</Window>
