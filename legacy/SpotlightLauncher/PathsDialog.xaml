<Window x:Class="SpotlightLauncher.PathsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SpotlightLauncher - 扫描路径"
        Width="440" Height="360"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale">

    <!-- 终末地风格:与主窗一致的黑灰底 + 荧光黄点缀 + 终端标题行 + 四角角标 -->

    <Window.Resources>
        <!-- 终端风按钮:暗底 + 1px 边,悬停荧光描边 -->
        <Style x:Key="TerminalButton" TargetType="Button">
            <Setter Property="Background" Value="#FF1E2029"/>
            <Setter Property="Foreground" Value="#FFE8E8E9"/>
            <Setter Property="BorderBrush" Value="#FF3A3D4A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF2A2D38"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FFFAFC52"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 行内删除按钮:暗色 ×,悬停荧光黄 -->
        <Style x:Key="DeletePathButton" TargetType="Button">
            <Setter Property="Content" Value="×"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FF6A6C76"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#FFFAFC52"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border CornerRadius="12" Background="#F2101418" BorderBrush="#FF3A3D4A"
            BorderThickness="1" SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ========== 标题行（可拖动） ========== -->
            <Grid Grid.Row="0" Margin="18,12,18,9"
                  MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Grid Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Path Stroke="#FFFAFC52" StrokeThickness="1.2" Fill="Transparent"
                              Data="M 1,13 L 7,2 L 13,13"/>
                        <Path Stroke="#FF8A8C2E" StrokeThickness="0.7" Fill="Transparent"
                              Data="M 3.5,9.5 L 7,4 L 10.5,9.5"/>
                    </Grid>
                    <TextBlock Text="ENDFIELD" Foreground="#FFF4F4F2" FontFamily="Consolas"
                               FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock Text=" // SCAN_PATHS" Foreground="#FF8A8C2E" FontFamily="Consolas"
                               FontSize="10" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="v1.4" Foreground="#FF5A5C1E" FontFamily="Consolas" FontSize="9"
                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>

            <!-- ========== 路径列表 ========== -->
            <Grid Grid.Row="1">
                <ListBox x:Name="PathList"
                         Background="Transparent" BorderThickness="0"
                         Margin="8,2,8,6"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionMode="Single">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,1"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Grid>
                                            <Rectangle x:Name="EnergyBar" Width="3" Fill="Transparent"
                                                       HorizontalAlignment="Left" VerticalAlignment="Stretch" Margin="0,4"/>
                                            <Border x:Name="Bg" CornerRadius="6" Background="Transparent"
                                                    Padding="10,0" Margin="3,0,0,0">
                                                <ContentPresenter/>
                                            </Border>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="EnergyBar" Property="Fill" Value="#FFFAFC52"/>
                                                <Setter TargetName="Bg" Property="Background" Value="#2A2D38"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="#1E2029"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="34">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Path}" FontSize="12.5"
                                               Foreground="#FFE8E8E9" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Kind}" FontSize="9.5"
                                               Foreground="#FF757780" Margin="0,1,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource DeletePathButton}"
                                        Tag="{Binding Path}" Click="OnDeleteClick"
                                        ToolTip="删除此路径" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 空态提示 -->
                <TextBlock x:Name="EmptyHint" Text="暂无自定义路径"
                           Foreground="#FF5A5C66" FontFamily="Microsoft YaHei UI" FontSize="12"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsHitTestVisible="False"/>
            </Grid>

            <!-- ========== 底部按钮 ========== -->
            <StackPanel Grid.Row="2" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="18,4,18,14">
                <Button Content="添加文件…" Style="{StaticResource TerminalButton}" Click="OnAddFileClick"/>
                <Button Content="添加文件夹…" Style="{StaticResource TerminalButton}" Click="OnAddFolderClick"/>
                <Button Content="关闭" Style="{StaticResource TerminalButton}" Click="OnCloseClick"/>
            </StackPanel>

            <!-- ========== 四角终端角标 ========== -->
            <TextBlock Text="&#x250C;" Foreground="#FF6A6C1E" FontFamily="Consolas" FontSize="13"
                       HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,4"/>
            <TextBlock Text="&#x2510;" Foreground="#FF6A6C1E" FontFamily="Consolas" FontSize="13"
                       HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,6,0"/>
            <TextBlock Text="&#x2514;" Foreground="#FF6A6C1E" FontFamily="Consolas" FontSize="13"
                       HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6,0,0,4"/>
            <TextBlock Text="&#x2518;" Foreground="#FF6A6C1E" FontFamily="Consolas" FontSize="13"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,4"/>
        </Grid>
    </Border>
</Window>
