<Window x:Class="SpotlightLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SpotlightLauncher"
        Width="520"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale"
        Deactivated="OnWindowDeactivated">

    <!-- 终末地风格：黑灰底 + 荧光黄(250,252,82)小面积点缀 + 白色卡片搜索框 -->

    <Window.Resources>
        <!-- 细滚动条：窄透明轨道 + 荧光黄绿滑块，隐藏默认箭头按钮 -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="4"/>
            <Setter Property="MinWidth" Value="4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="Bg" Background="Transparent" SnapsToDevicePixels="True">
                            <!-- 暗色轨道槽 -->
                            <Rectangle x:Name="TrackBg" Fill="#FF1A1D24" Width="4" RadiusX="2" RadiusY="2"
                                       HorizontalAlignment="Center" Opacity="0.55"/>
                            <Track x:Name="PART_Track" IsDirectionReversed="True"
                                   ViewportSize="{TemplateBinding ViewportSize}"
                                   Value="{TemplateBinding Value}"
                                   Maximum="{TemplateBinding Maximum}"
                                   Minimum="{TemplateBinding Minimum}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.LineUpCommand}"
                                                  Focusable="False" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Rectangle Fill="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb" Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                            <Rectangle x:Name="Rect" Fill="#FAFC52" RadiusX="3" RadiusY="3"
                                                           Opacity="0.85" SnapsToDevicePixels="True"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Rect" Property="Opacity" Value="1.0"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.LineDownCommand}"
                                                  Focusable="False" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Rectangle Fill="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Width" Value="Auto"/>
                                <Setter Property="Height" Value="4"/>
                                <Setter Property="MinHeight" Value="4"/>
                                <Setter TargetName="TrackBg" Property="Width" Value="Auto"/>
                                <Setter TargetName="TrackBg" Property="Height" Value="4"/>
                                <Setter TargetName="TrackBg" Property="HorizontalAlignment" Value="Stretch"/>
                                <Setter TargetName="TrackBg" Property="VerticalAlignment" Value="Center"/>
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 右键菜单：终末地暗色终端风（与主面板统一） ===== -->
        <Style x:Key="ResultContextMenu" TargetType="ContextMenu">
            <Setter Property="Background" Value="#FF1A1D26"/>
            <Setter Property="BorderBrush" Value="#FF3A3D4A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,4"/>
            <Setter Property="MinWidth" Value="220"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="18"
                                                  ShadowDepth="4" Direction="270" Opacity="0.6"/>
                            </Border.Effect>
                            <ItemsPresenter x:Name="ItemsPresenter"
                                            KeyboardNavigation.DirectionalNavigation="Cycle"
                                            Grid.IsSharedSizeScope="True"
                                            Margin="{TemplateBinding Padding}"
                                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 菜单项：暗底 + 左侧荧光竖条 + 图标 + 标题 + 右侧快捷键 -->
        <Style x:Key="ResultMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#FFE8E8E9"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,8,16,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid x:Name="Grid" Background="Transparent" Margin="2,1" SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" SharedSizeGroup="Icon"/>
                                <ColumnDefinition Width="*" SharedSizeGroup="Header"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Gesture"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Bg" Grid.ColumnSpan="3" CornerRadius="5"
                                    Background="Transparent" SnapsToDevicePixels="True"/>
                            <!-- 左侧荧光竖条（悬停/选中时点亮，与主面板选中项一致） -->
                            <Rectangle x:Name="EnergyBar" Grid.ColumnSpan="3" Width="2"
                                       Fill="Transparent" HorizontalAlignment="Left"
                                       VerticalAlignment="Stretch" Margin="0,3"/>
                            <ContentPresenter x:Name="Icon" Grid.Column="0" ContentSource="Icon"
                                              Width="16" Height="16"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <ContentPresenter x:Name="Header" Grid.Column="1" ContentSource="Header"
                                              RecognizesAccessKey="True" Margin="6,0,12,0"
                                              HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <TextBlock x:Name="Gesture" Grid.Column="2"
                                       Text="{TemplateBinding InputGestureText}"
                                       Foreground="#FF6A6C76" FontFamily="Consolas" FontSize="10.5"
                                       VerticalAlignment="Center" Margin="0,0,4,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FF2A2D38"/>
                                <Setter TargetName="EnergyBar" Property="Fill" Value="#FFFAFC52"/>
                                <Setter TargetName="Gesture" Property="Foreground" Value="#FFB9BB1E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Header" Property="TextElement.Foreground" Value="#FF5A5C66"/>
                                <Setter TargetName="Icon" Property="Opacity" Value="0.35"/>
                                <Setter TargetName="Gesture" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 分隔线：暗色细线 -->
        <Style x:Key="ResultSeparator" TargetType="Separator">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="10,6,10,6"/>
            <Setter Property="Background" Value="#FF262932"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Rectangle Fill="{TemplateBinding Background}" Height="1" SnapsToDevicePixels="True"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="12"
            Background="#F2101418"
            BorderBrush="#FF3A3D4A"
            BorderThickness="1"
            SnapsToDevicePixels="True">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ========== 标题行（工业终端风：三角山形 logo + 终端注释 + 坐标刻度） ========== -->
            <Grid Grid.Row="0" Margin="18,12,18,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <!-- 终末地山形三角 logo（荧光黄描边 + 内部等高线） -->
                    <Grid Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Path Stroke="#FFFAFC52" StrokeThickness="1.2" Fill="Transparent"
                              Data="M 1,13 L 7,2 L 13,13"/>
                        <Path Stroke="#FF8A8C2E" StrokeThickness="0.7" Fill="Transparent"
                              Data="M 3.5,9.5 L 7,4 L 10.5,9.5"/>
                    </Grid>
                    <TextBlock Text="ENDFIELD" Foreground="#FFF4F4F2" FontFamily="Consolas"
                               FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ModeSuffix" Text=" // APP_LAUNCHER" Foreground="#FF8A8C2E" FontFamily="Consolas"
                               FontSize="10" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 右侧：模式切换 Tab + 坐标/能量刻度 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- 软件模式 Tab -->
                    <Border x:Name="AppModeTab" Tag="app" Cursor="Hand" CornerRadius="4"
                            Padding="7,2" Margin="0,0,3,0" VerticalAlignment="Center"
                            MouseLeftButtonDown="OnModeTabClick">
                        <TextBlock x:Name="AppModeText" Text="软件" FontFamily="Consolas" FontSize="10" VerticalAlignment="Center"/>
                    </Border>
                    <!-- 剪贴板模式 Tab -->
                    <Border x:Name="ClipModeTab" Tag="clip" Cursor="Hand" CornerRadius="4"
                            Padding="7,2" Margin="0,0,10,0" VerticalAlignment="Center"
                            MouseLeftButtonDown="OnModeTabClick">
                        <TextBlock x:Name="ClipModeText" Text="剪贴板" FontFamily="Consolas" FontSize="10" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="v1.0" Foreground="#FF5A5C1E" FontFamily="Consolas" FontSize="9" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Rectangle Width="2" Height="2" Fill="#FF5A5C1E" Margin="0,0,3,0"/>
                    <Rectangle Width="3" Height="3" Fill="#FF8A8C2E" Margin="0,0,3,0"/>
                    <Rectangle Width="4" Height="4" Fill="#FFFAFC52"/>
                </StackPanel>
            </Grid>

            <!-- ========== 搜索行（白色卡片：白底 + 细深色边 + 柔和投影，荧黄仅作聚焦点缀） ========== -->
            <Border Grid.Row="1" Margin="18,2,18,10" CornerRadius="9"
                    Background="#FFFCFCFA" BorderBrush="#FF3A3D4A" BorderThickness="1.5">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="3" Direction="270" Opacity="0.45"/>
                </Border.Effect>

                <Grid Margin="12,9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="&#x2315;" FontFamily="Segoe UI Symbol" FontSize="16"
                               Foreground="#FF4A4C58" VerticalAlignment="Center" Margin="0,0,10,0"/>

                    <TextBox x:Name="SearchBox" Grid.Column="1"
                             Background="Transparent" BorderThickness="0"
                             Foreground="#FF1A1B22" CaretBrush="#FFB9BB1E"
                             FontFamily="Segoe UI Semibold" FontSize="15"
                             VerticalContentAlignment="Center"
                             TextChanged="OnSearchTextChanged"
                             PreviewKeyDown="OnSearchBoxKeyDown"/>

                    <Button x:Name="ReindexButton" Grid.Column="2"
                            Click="OnReindexClick"
                            ToolTip="重新索引：扫描新安装的软件"
                            Background="Transparent" BorderThickness="0"
                            Foreground="#FF4A4C58" Cursor="Hand"
                            FontFamily="Segoe UI" FontSize="12"
                            VerticalAlignment="Center" Margin="8,0,0,0"
                            Padding="6,3">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#x21BB;" FontFamily="Segoe UI Symbol" FontSize="13"
                                       Foreground="#FF8A8C2E" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock x:Name="ReindexLabel" Text="索引" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- ========== 结果列表 ========== -->
            <ListBox x:Name="ResultList" Grid.Row="3"
                     Background="Transparent" BorderThickness="0"
                     Margin="8,2,8,10"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionMode="Single"
                     PreviewKeyDown="OnResultListKeyDown"
                     MouseLeftButtonUp="OnResultListClick"
                     PreviewMouseRightButtonDown="OnResultListPreviewRightDown"
                     ContextMenuOpening="OnResultListContextMenuOpening">

                <ListBox.ContextMenu>
                    <ContextMenu Style="{StaticResource ResultContextMenu}">
                        <MenuItem x:Name="OpenLocationMenuItem" Style="{StaticResource ResultMenuItem}"
                                  Header="打开文件所在位置" InputGestureText="Ctrl+Shift+F"
                                  Click="OnOpenFileLocationClick">
                            <MenuItem.Icon>
                                <Path Width="14" Height="14" Stretch="Uniform"
                                      Data="M2 4 a1 1 0 0 1 1-1 h3 l1.5 1.5 h4.5 a1 1 0 0 1 1 1 v6 a1 1 0 0 1 -1 1 h-10 a1 1 0 0 1 -1 -1 z"
                                      Fill="Transparent" Stroke="#FFFAFC52" StrokeThickness="1.2"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="CopyPathMenuItem" Style="{StaticResource ResultMenuItem}"
                                  Header="复制文件路径" InputGestureText="Ctrl+Shift+C"
                                  Click="OnCopyPathClick">
                            <MenuItem.Icon>
                                <Grid Width="14" Height="14">
                                    <Path Data="M5 3 h7 a1.2 1.2 0 0 1 1.2 1.2 v7 a1.2 1.2 0 0 1 -1.2 1.2 h-7 a1.2 1.2 0 0 1 -1.2 -1.2 v-7 a1.2 1.2 0 0 1 1.2 -1.2 z"
                                          Fill="Transparent" Stroke="#FFFAFC52" StrokeThickness="1.1"
                                          Stretch="Uniform"/>
                                    <Path Data="M3 6 h7 a1.2 1.2 0 0 1 1.2 1.2 v7 a1.2 1.2 0 0 1 -1.2 1.2 h-7 a1.2 1.2 0 0 1 -1.2 -1.2 v-7 a1.2 1.2 0 0 1 1.2 -1.2 z"
                                          Fill="Transparent" Stroke="#FFFAFC52" StrokeThickness="1.1"
                                          Stretch="Uniform"/>
                                </Grid>
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator Style="{StaticResource ResultSeparator}"/>
                        <MenuItem x:Name="RunAsAdminMenuItem" Style="{StaticResource ResultMenuItem}"
                                  Header="以管理员身份运行" InputGestureText="Ctrl+Shift+Enter"
                                  Click="OnRunAsAdminClick">
                            <MenuItem.Icon>
                                <Path Width="14" Height="14" Stretch="Uniform"
                                      Data="M8 2 L13 4 V8 C13 11 10.5 13.2 8 14 C5.5 13.2 3 11 3 8 V4 Z"
                                      Fill="Transparent" Stroke="#FFFAFC52" StrokeThickness="1.2"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </ListBox.ContextMenu>


                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,1"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Grid>
                                        <!-- 左侧荧光黄竖条（选中时点亮，小面积点缀） -->
                                        <Rectangle x:Name="EnergyBar" Width="3" Fill="Transparent"
                                                   HorizontalAlignment="Left" VerticalAlignment="Stretch" Margin="0,4"/>
                                        <Border x:Name="Bg" CornerRadius="6" Background="Transparent"
                                                Padding="10,0" Margin="3,0,0,0">
                                            <ContentPresenter/>
                                        </Border>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="EnergyBar" Property="Fill" Value="#FFFAFC52"/>
                                            <Setter TargetName="Bg" Property="Background" Value="#2A2D38"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#1E2029"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="38">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Width="18" Height="18" Stretch="Uniform"
                                   Source="{Binding Icon}" VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0">
                                <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="#FFE8E8E9" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Subtitle}" FontSize="9.5"
                                           Foreground="#FF757780" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- ========== 四角终端角标（暗荧光黄） ========== -->
            <TextBlock Text="&#x250C;" Foreground="#FF6A6C1E" FontFamily="Consolas" FontSize="13"
                       HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,4"/>
            <TextBlock Text="&#x2510;" Foreground="#FF6A6C1E" FontFamily="Consolas" FontSize="13"
                       HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,6,0"/>
            <TextBlock Text="&#x2514;" Foreground="#FF6A6C1E" FontFamily="Consolas" FontSize="13"
                       HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6,0,0,4"/>
            <TextBlock Text="&#x2518;" Foreground="#FF6A6C1E" FontFamily="Consolas" FontSize="13"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,4"/>
        </Grid>
    </Border>
</Window>
