<Window x:Class="MiniMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="3xgcafe Monitor"
        Width="240" SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="False"
        ShowInTaskbar="False"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale">

    <!-- 半透明黑底（壁纸透出）+ 四角制表符角标 + 长条进度线；保持黑白灰配色，不引入荧光黄等装饰色 -->
    <Grid x:Name="Root"
          Background="#9E0E0E10"
          MouseLeftButtonDown="Root_OnMouseLeftButtonDown"
          MouseRightButtonUp="Root_OnMouseRightButtonUp">

        <!-- ========== 顶部标题区 ========== -->
        <Grid Margin="18,12,18,0" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Rectangle Width="3" Height="3" Fill="#FFE8E8E8" Margin="0,0,7,0" VerticalAlignment="Center"/>
                <TextBlock Text="MINI MONITOR" Foreground="#FFA9A9A9"
                           FontFamily="Consolas" FontSize="12.5" FontWeight="Bold" TextDecorations="Underline" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Rectangle Width="2" Height="2" Fill="#FFA9A9A9" Margin="0,0,3,0"/>
                <Rectangle Width="3" Height="3" Fill="#FFC9C9C9" Margin="0,0,3,0"/>
                <Rectangle Width="4" Height="4" Fill="#FFE8E8E8"/>
            </StackPanel>
        </Grid>

        <!-- 标题分隔线 -->
        <Rectangle Height="1" Fill="#FF262626" Margin="18,29,18,0" VerticalAlignment="Top"/>

        <!-- ========== 七项数据 ========== -->
        <Grid Margin="18,37,18,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.Resources>
                <Style x:Key="Lbl" TargetType="TextBlock">
                    <Setter Property="Foreground" Value="#FFC9C9C9"/>
                    <Setter Property="FontFamily" Value="Consolas"/>
                    <Setter Property="FontSize" Value="10"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                </Style>
                <Style x:Key="Val" TargetType="TextBlock">
                    <Setter Property="Foreground" Value="#FFE8E8E8"/>
                    <Setter Property="FontFamily" Value="Consolas"/>
                    <Setter Property="FontSize" Value="11"/>
                    <Setter Property="TextAlignment" Value="Right"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                </Style>
                <Style x:Key="Track" TargetType="Grid">
                    <Setter Property="Height" Value="3"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="Background" Value="#FF262626"/>
                </Style>
                <Style x:Key="Bar" TargetType="Rectangle">
                    <Setter Property="Fill" Value="#FFE8E8E8"/>
                    <Setter Property="Width" Value="0"/>
                    <Setter Property="HorizontalAlignment" Value="Left"/>
                    <Setter Property="VerticalAlignment" Value="Stretch"/>
                </Style>
            </Grid.Resources>

            <!-- CPU -->
            <Grid x:Name="CpuRow" Grid.Row="0" Height="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="CPU" Style="{StaticResource Lbl}"/>
                <Grid x:Name="CpuTrack" Grid.Column="1" Style="{StaticResource Track}">
                    <Rectangle x:Name="CpuBar" Style="{StaticResource Bar}"/>
                </Grid>
                <TextBlock x:Name="CpuText" Grid.Column="2" Text="--" Style="{StaticResource Val}"/>
            </Grid>

            <!-- CPU 温度 -->
            <Grid x:Name="TempRow" Grid.Row="1" Height="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="TMP" Style="{StaticResource Lbl}"/>
                <Grid x:Name="TempTrack" Grid.Column="1" Style="{StaticResource Track}">
                    <Rectangle x:Name="TempBar" Style="{StaticResource Bar}"/>
                </Grid>
                <TextBlock x:Name="TempText" Grid.Column="2" Text="--" Style="{StaticResource Val}"/>
            </Grid>

            <!-- GPU0 -->
            <Grid x:Name="Gpu0Row" Grid.Row="2" Height="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Gpu0Label" Grid.Column="0" Text="GPU0" Style="{StaticResource Lbl}"/>
                <Grid x:Name="Gpu0Track" Grid.Column="1" Style="{StaticResource Track}">
                    <Rectangle x:Name="Gpu0Bar" Style="{StaticResource Bar}"/>
                </Grid>
                <TextBlock x:Name="Gpu0Text" Grid.Column="2" Text="--" Style="{StaticResource Val}"/>
            </Grid>

            <!-- GPU1 -->
            <Grid x:Name="Gpu1Row" Grid.Row="3" Height="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Gpu1Label" Grid.Column="0" Text="GPU1" Style="{StaticResource Lbl}"/>
                <Grid x:Name="Gpu1Track" Grid.Column="1" Style="{StaticResource Track}">
                    <Rectangle x:Name="Gpu1Bar" Style="{StaticResource Bar}"/>
                </Grid>
                <TextBlock x:Name="Gpu1Text" Grid.Column="2" Text="--" Style="{StaticResource Val}"/>
            </Grid>

            <!-- 内存 -->
            <Grid x:Name="MemRow" Grid.Row="4" Height="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="MEM" Style="{StaticResource Lbl}"/>
                <Grid x:Name="MemTrack" Grid.Column="1" Style="{StaticResource Track}">
                    <Rectangle x:Name="MemBar" Style="{StaticResource Bar}"/>
                </Grid>
                <TextBlock x:Name="MemText" Grid.Column="2" Text="--" Style="{StaticResource Val}"/>
            </Grid>

            <!-- 磁盘行 0（盘符由启动检测/设置决定，默认自动检测第一个固定盘） -->
            <Grid x:Name="Disk0Row" Grid.Row="5" Height="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Disk0Label" Grid.Column="0" Text="DSK-" Style="{StaticResource Lbl}"/>
                <Grid x:Name="Disk0Track" Grid.Column="1" Style="{StaticResource Track}">
                    <Rectangle x:Name="Disk0Bar" Style="{StaticResource Bar}"/>
                </Grid>
                <TextBlock x:Name="Disk0Text" Grid.Column="2" Text="--" Style="{StaticResource Val}"/>
            </Grid>

            <!-- 磁盘行 1 -->
            <Grid x:Name="Disk1Row" Grid.Row="6" Height="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Disk1Label" Grid.Column="0" Text="DSK-" Style="{StaticResource Lbl}"/>
                <Grid x:Name="Disk1Track" Grid.Column="1" Style="{StaticResource Track}">
                    <Rectangle x:Name="Disk1Bar" Style="{StaticResource Bar}"/>
                </Grid>
                <TextBlock x:Name="Disk1Text" Grid.Column="2" Text="--" Style="{StaticResource Val}"/>
            </Grid>

            <!-- 电池 -->
            <Grid x:Name="BatRow" Grid.Row="7" Height="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="BAT" Style="{StaticResource Lbl}"/>
                <Grid x:Name="BatTrack" Grid.Column="1" Style="{StaticResource Track}">
                    <Rectangle x:Name="BatBar" Style="{StaticResource Bar}"/>
                </Grid>
                <TextBlock x:Name="BatText" Grid.Column="2" Text="--" Style="{StaticResource Val}"/>
            </Grid>

            <!-- 网络下载 -->
            <Grid x:Name="RxRow" Grid.Row="8" Height="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="RX" Style="{StaticResource Lbl}"/>
                <Grid x:Name="RxTrack" Grid.Column="1" Style="{StaticResource Track}">
                    <Rectangle x:Name="RxBar" Style="{StaticResource Bar}"/>
                </Grid>
                <TextBlock x:Name="RxText" Grid.Column="2" Text="--" Style="{StaticResource Val}"/>
            </Grid>

            <!-- 网络上传 -->
            <Grid x:Name="TxRow" Grid.Row="9" Height="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="TX" Style="{StaticResource Lbl}"/>
                <Grid x:Name="TxTrack" Grid.Column="1" Style="{StaticResource Track}">
                    <Rectangle x:Name="TxBar" Style="{StaticResource Bar}"/>
                </Grid>
                <TextBlock x:Name="TxText" Grid.Column="2" Text="--" Style="{StaticResource Val}"/>
            </Grid>
        </Grid>

        <!-- 底部装饰刻度 -->
        <Rectangle Width="28" Height="1" Fill="#FF3A3A3A"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,18,8"/>

        <!-- ========== 四角制表符角标 ========== -->
        <TextBlock Text="&#x250C;" Foreground="#FF8A8A8A" FontFamily="Consolas" FontSize="13"
                   HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,4"/>
        <TextBlock Text="&#x2510;" Foreground="#FF8A8A8A" FontFamily="Consolas" FontSize="13"
                   HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,6,0"/>
        <TextBlock Text="&#x2514;" Foreground="#FF8A8A8A" FontFamily="Consolas" FontSize="13"
                   HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6,0,0,4"/>
        <TextBlock Text="&#x2518;" Foreground="#FF8A8A8A" FontFamily="Consolas" FontSize="13"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,4"/>
    </Grid>
</Window>
