<Window x:Class="ThreeXGCafeConsole.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="3xgcafe Console"
        Width="1060" Height="660"
        MinWidth="760" MinHeight="460"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="#0D0F12"
        Foreground="#E8E8EC"
        TextOptions.TextFormattingMode="Display"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0"
                      CaptionHeight="0"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      NonClientFrameEdges="None" />
    </WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶栏 -->
        <Border Grid.Row="0" Background="#0D0F12" BorderBrush="#2A2F37" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Grid Margin="18,14,14,12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Rectangle Width="10" Height="10" Fill="#E3C443" VerticalAlignment="Center" />
                    <TextBlock Text="3xgcafe console" FontSize="15" FontWeight="SemiBold" Margin="10,0,0,0"
                               VerticalAlignment="Center" />
                    <TextBlock Text="统一管理面板" FontSize="12" Foreground="#8A9099" Margin="10,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="OnlineText" FontFamily="Consolas" FontSize="12" Foreground="#8A9099"
                               VerticalAlignment="Center" Margin="0,0,14,0" />
                    <TextBlock x:Name="ClockText" FontFamily="Consolas" FontSize="12" Foreground="#8A9099"
                               VerticalAlignment="Center" Margin="0,0,14,0" />
                    <Button Width="30" Height="24" Style="{StaticResource ConsoleButton}"
                            Click="Minimize_Click" Margin="0,0,6,0"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path Data="M0,12 L16,12" Stroke="#C9CDD4" StrokeThickness="1.5"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                    <Button Width="30" Height="24" Style="{StaticResource ConsoleButton}"
                            Click="Close_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path Data="M0,0 L14,14 M0,14 L14,0" Stroke="#C9CDD4" StrokeThickness="1.5"
                              HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="None" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 工具卡片区 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,0,0">
            <WrapPanel x:Name="CardHost" Margin="14,14,14,6" Orientation="Horizontal" />
        </ScrollViewer>

        <!-- 底栏 -->
        <Border Grid.Row="2" Background="#0D0F12" BorderBrush="#2A2F37" BorderThickness="0,1,0,0">
            <Grid Margin="18,10,14,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="StatusText" FontFamily="Consolas" FontSize="12" Foreground="#8A9099"
                           VerticalAlignment="Center" Margin="0,0,14,0"
                           TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <CheckBox x:Name="PanelAutoStartCheck" Content="面板随 Windows 启动"
                              Style="{StaticResource ConsoleCheckBox}"
                              VerticalAlignment="Center" Margin="0,0,14,0"
                              Click="PanelAutoStart_Click" />
                    <Button Content="添加工具" Style="{StaticResource ConsoleButton}" Margin="0,0,8,0"
                            Click="AddTool_Click" />
                    <Button Content="打开目录" Style="{StaticResource ConsoleButton}" Margin="0,0,8,0"
                            Click="OpenFolder_Click" />
                    <Button Content="全部启动" Style="{StaticResource ConsoleButton}" Margin="0,0,8,0"
                            Click="StartAll_Click" />
                    <Button Content="全部停止" Style="{StaticResource ConsoleButton}" Margin="0,0,8,0"
                            Click="StopAll_Click" />
                    <Button Content="刷新" Style="{StaticResource ConsoleAccentButton}"
                            Click="Refresh_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
