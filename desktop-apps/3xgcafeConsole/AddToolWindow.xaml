<Window x:Class="ThreeXGCafeConsole.AddToolWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加工具"
        Width="520" SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#0D0F12"
        Foreground="#E8E8EC"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        MouseLeftButtonDown="Root_MouseLeftButtonDown">
    <Border BorderBrush="#2A2F37" BorderThickness="1">
        <StackPanel Margin="20,16,20,18">

            <StackPanel Orientation="Horizontal">
                <Rectangle Width="10" Height="10" Fill="#E3C443" VerticalAlignment="Center" />
                <TextBlock Text="添加工具" FontSize="14" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Text="名称" FontSize="12" Foreground="#8A9099" Margin="0,16,0,6" />
            <TextBox x:Name="NameBox" Height="32" FontSize="13"
                     Background="#14171C" Foreground="#E8E8EC" BorderBrush="#2A2F37"
                     VerticalContentAlignment="Center" Padding="8,0" />

            <TextBlock Text="说明（可留空）" FontSize="12" Foreground="#8A9099" Margin="0,12,0,6" />
            <TextBox x:Name="SubtitleBox" Height="32" FontSize="13"
                     Background="#14171C" Foreground="#E8E8EC" BorderBrush="#2A2F37"
                     VerticalContentAlignment="Center" Padding="8,0" />

            <TextBlock Text="可执行文件" FontSize="12" Foreground="#8A9099" Margin="0,12,0,6" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="PathBox" Grid.Column="0" Height="32" FontSize="13"
                         Background="#14171C" Foreground="#E8E8EC" BorderBrush="#2A2F37"
                         VerticalContentAlignment="Center" Padding="8,0" />
                <Button Grid.Column="1" Content="浏览…" Width="76" Height="32" Margin="8,0,0,0"
                        Style="{StaticResource ConsoleButton}" Click="Browse_Click" />
            </Grid>

            <TextBlock Text="状态通道名（留空表示该工具暂无通道，仅做进程级管理）"
                       FontSize="12" Foreground="#8A9099" Margin="0,12,0,6" />
            <TextBox x:Name="PipeBox" Height="32" FontSize="13"
                     Background="#14171C" Foreground="#E8E8EC" BorderBrush="#2A2F37"
                     VerticalContentAlignment="Center" Padding="8,0" />

            <TextBlock x:Name="ErrorText" FontSize="12" Foreground="#FF7A7A" Margin="0,12,0,0"
                       TextWrapping="Wrap" Visibility="Collapsed" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="取消" Width="84" Height="32" Style="{StaticResource ConsoleButton}"
                        Click="Cancel_Click" Margin="0,0,8,0" />
                <Button Content="添加" Width="100" Height="32" Style="{StaticResource ConsoleAccentButton}"
                        Click="Ok_Click" />
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
