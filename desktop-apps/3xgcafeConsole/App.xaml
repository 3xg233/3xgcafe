<Application x:Class="ThreeXGCafeConsole.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>

        <!-- 配色：深炭底 + 工业黄，参照终末地的工业界面观感 -->
        <SolidColorBrush x:Key="BgBrush" Color="#0D0F12" />
        <SolidColorBrush x:Key="CardBrush" Color="#14171C" />
        <SolidColorBrush x:Key="LineBrush" Color="#2A2F37" />
        <SolidColorBrush x:Key="AccentBrush" Color="#E3C443" />
        <SolidColorBrush x:Key="TextBrush" Color="#E8E8EC" />
        <SolidColorBrush x:Key="MutedBrush" Color="#8A9099" />
        <SolidColorBrush x:Key="OkBrush" Color="#6FBF73" />

        <!-- 工业方角按钮 -->
        <Style x:Key="ConsoleButton" TargetType="Button">
            <Setter Property="Background" Value="#14171C" />
            <Setter Property="Foreground" Value="#C9CDD4" />
            <Setter Property="BorderBrush" Value="#2A2F37" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="10,4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#E3C443" />
                                <Setter Property="Foreground" Value="#E3C443" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E222A" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主操作按钮（工业黄实底） -->
        <Style x:Key="ConsoleAccentButton" TargetType="Button">
            <Setter Property="Background" Value="#E3C443" />
            <Setter Property="Foreground" Value="#0D0F12" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <ContentPresenter Margin="14,5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F0D25A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C9AC38" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#3A3A42" />
                                <Setter Property="Foreground" Value="#77777F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ConsoleCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#8A9099" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

    </Application.Resources>
</Application>
