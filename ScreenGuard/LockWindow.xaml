<Window x:Class="ScreenGuard.LockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="3xgcafe Guard"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        WindowStartupLocation="Manual"
        Background="Transparent"
        Foreground="#E8E8EC"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Grid>
        <!-- 桌面模糊快照：仅作实时模糊（亚克力）失败时的兜底；正常不显示 -->
        <Image x:Name="BackdropImage"
               Stretch="Fill"
               Visibility="Collapsed"
               SnapsToDevicePixels="True" />

        <Canvas x:Name="RootCanvas">
            <Border x:Name="Panel"
                    Width="440"
                    Padding="34,30,34,26"
                    Background="#C814141A"
                    BorderBrush="#33FFFFFF"
                    BorderThickness="1"
                    CornerRadius="16">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="34" ShadowDepth="0" Opacity="0.5" Color="#000000" />
                </Border.Effect>
                <StackPanel>
                    <!-- 简笔锁形图标（避免 emoji 字体缺字） -->
                    <Canvas Width="46" Height="42" HorizontalAlignment="Center">
                        <Path Data="M 13,21 A 10,10 0 0 1 33,21"
                              Stroke="#FAFC52" StrokeThickness="3.4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Border Canvas.Left="8" Canvas.Top="20" Width="30" Height="21"
                                CornerRadius="4" Background="#FAFC52" />
                        <Ellipse Canvas.Left="20" Canvas.Top="27" Width="6" Height="6" Fill="#14141A" />
                    </Canvas>

                    <TextBlock Text="电脑已锁定"
                               FontSize="23" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,16,0,0" />

                    <TextBlock Text="请输入密码解锁"
                               FontSize="13" Foreground="#B9B9C4"
                               HorizontalAlignment="Center" Margin="0,8,0,0" />

                    <TextBlock x:Name="HintText"
                               FontSize="12.5" Foreground="#9A9AA6"
                               HorizontalAlignment="Center" Margin="0,8,0,0"
                               TextWrapping="Wrap" TextAlignment="Center"
                               Visibility="Collapsed" />

                    <Grid Height="40" Margin="0,24,0,0">
                        <PasswordBox x:Name="PasswordInput"
                                     Height="40"
                                     Style="{StaticResource DarkPasswordBox}" />
                        <!-- 明文显示框：与密码框同款式样，点"显示"时切换可见 -->
                        <TextBox x:Name="PasswordReveal"
                                 Style="{StaticResource DarkTextBox}"
                                 Height="40" FontSize="15" Padding="12,0"
                                 Visibility="Collapsed" />
                        <Button x:Name="RevealButton"
                                Content="显示"
                                Width="52" Height="28"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="0,0,6,0"
                                FontSize="12"
                                Style="{StaticResource GhostButton}"
                                Click="RevealButton_Click" />
                    </Grid>

                    <TextBlock x:Name="ErrorText"
                               FontSize="12.5" Foreground="#FF7A7A"
                               Margin="0,10,0,0"
                               TextWrapping="Wrap" TextAlignment="Center"
                               Visibility="Collapsed" />

                    <Button x:Name="UnlockButton"
                            Content="解 锁"
                            Height="40" Margin="0,18,0,0"
                            IsDefault="True"
                            Style="{StaticResource AccentButton}"
                            Click="UnlockButton_Click" />

                    <TextBlock x:Name="ClockText"
                               FontSize="12" Foreground="#8E8E9A"
                               HorizontalAlignment="Center" Margin="0,18,0,0" />
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</Window>
